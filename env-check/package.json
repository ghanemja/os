{
  "name": "env-check",
  "version": "1.0.0",
  "description": "Validate environment variables at startup with typed results and clear errors. Includes a dependency-free .env parser and CLI.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "env-check": "bin/env-check.js"
  },
  "files": ["index.js", "index.d.ts", "bin/"],
  "scripts": {
    "test": "node --test"
  },
  "keywords": ["env", "dotenv", "environment", "config", "validation", "schema", "cli"],
  "author": "ghanemja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ghanemja/env-check"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
